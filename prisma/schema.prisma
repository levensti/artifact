// Artifact persistent store. All domain rows are scoped by `userId` and
// cascade-deleted when the owning user disappears.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js (NextAuth) ──────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Scrypt-hashed password for the email + password sign-in flow. Null
  /// for users who only authenticate through an OAuth provider (e.g.
  /// Google). Format: "scrypt$<salt-hex>$<derived-hex>" — see
  /// src/server/passwords.ts.
  password      String?

  accounts Account[]
  sessions Session[]

  reviews           Review[]
  apiKeys           ApiKey[]
  inferenceProfiles InferenceProfile[]
  preferences       UserPreferences?
  pdfBlobs          PdfBlob[]
  shares            Share[]
  discoverQueries   DiscoverQuery[]
  projects          Project[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Domain ──────────────────────────────────────────────────────

model Review {
  id                     String    @id @default(uuid())
  userId                 String
  title                  String
  arxivId                String?
  pdfPath                String? // PdfBlob id (no FK — PdfBlob may be deleted independently)
  sourceUrl              String?
  createdAt              DateTime
  updatedAt              DateTime
  importedAt             DateTime?
  /// Token of the share this review was imported from. Stored, not
  /// enforced via FK; the share row may be revoked or the owner may have
  /// deleted their copy. Drives the "Imported from {Owner}" badge.
  importedFromShareToken String?
  /// Snapshot of the sharer's display name at import time. Captured so the
  /// badge survives the original sharer renaming, deleting their account,
  /// or revoking the share.
  importedFromName       String?
  /// Set when this review was started from a Discover recommendation.
  /// Unique because a recommendation produces at most one review (upstream
  /// dedup via createOrGetReview enforces "one review per arxivId" so the
  /// rec→review action only fires once). SetNull preserves the review when
  /// the underlying recommendation is purged.
  fromRecommendationId   String?   @unique
  /// Project this review belongs to. Null = ungrouped. SetNull so deleting
  /// a project ungroups its papers without deleting them.
  projectId              String?
  /// The content-addressed document this review reads. Linked lazily the
  /// first time the client extracts the text (the hash is computed from the
  /// extracted text, which only the browser has). SetNull so a re-index or
  /// document purge never deletes the review.
  documentId             String?

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           ReviewMessages?
  annotations        ReviewAnnotations?
  artifacts          ReviewArtifact[]
  shares             Share[]
  fromRecommendation Recommendation?    @relation(fields: [fromRecommendationId], references: [id], onDelete: SetNull)
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  document           Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, arxivId])
  @@index([documentId])
}

model ReviewMessages {
  id              String @id @default(uuid())
  reviewId        String @unique
  messages        Json
  /// Per-conversation context state (see `ContextMetadata` in review-types):
  /// the compaction record (recap summary + boundary) and the last measured
  /// context size, written atomically with `messages`. Nullable: a fresh
  /// conversation has none until it grows or is compacted.
  contextMetadata Json?
  review          Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewAnnotations {
  id          String @id @default(uuid())
  reviewId    String @unique
  annotations Json
  review      Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

/// Interactive learning material the assistant generated for a review via the
/// `create_artifact` tool (e.g. a skimmable overview of the paper). Saved
/// separately from the chat so it survives "New chat", and never copied into
/// a share (artifacts run model-written script in a sandbox). Its content
/// lives in `ArtifactVersion`; the highest `number` is current.
model ReviewArtifact {
  id           String   @id @default(uuid())
  reviewId     String
  title        String
  summary      String
  /// The chat tool-call id that produced it; unique per review so a retried
  /// persist can't save the same artifact twice.
  sourceCallId String?
  /// What the reader did inside the artifact (quiz answers, slider
  /// positions), saved by the page through the sandbox bridge.
  state        Json?
  createdAt    DateTime @default(now())
  /// Bumped by new versions only (not by reader state), so the list sorts
  /// by the last edit.
  updatedAt    DateTime @default(now())

  review   Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  versions ArtifactVersion[]

  @@unique([reviewId, sourceCallId])
  @@index([reviewId, createdAt])
}

/// One saved state of an artifact's page. Every edit, restore, or undo
/// appends a version; nothing is overwritten.
model ArtifactVersion {
  id            String   @id @default(uuid())
  artifactId    String
  /// 1 for the original, counting up.
  number        Int
  /// The page source: HTML with inline style and script, run sandboxed.
  html          String
  /// One line on what changed ("Simplified the method section").
  changeSummary String
  /// The tool call that wrote it, if any (restores have none).
  sourceCallId  String?
  createdAt     DateTime @default(now())

  artifact ReviewArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, number])
}

/// API key for an external service (LLM provider or tool). The `value`
/// column holds the encrypted secret; see src/server/crypto.ts. The
/// `provider` discriminator currently spans LLM providers ("anthropic",
/// "openai", "xai") and tool keys ("exa").
model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// One named OpenAI- or Anthropic-compatible inference endpoint.
model InferenceProfile {
  id                String   @id @default(uuid())
  userId            String
  label             String
  kind              String
  baseUrl           String
  apiKey            String
  supportsStreaming Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-user UI preferences. `selectedModel` holds the currently-selected
/// model as JSON because the Model shape is denormalized (id, label,
/// provider, modelId, optional profileId) and is never queried by field.
model UserPreferences {
  userId        String @id
  selectedModel Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PdfBlob {
  id          String   @id @default(uuid())
  userId      String
  name        String?
  storagePath String
  createdAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A document (paper PDF or web page) identified by the sha256 of its
/// extracted text. Deliberately NOT scoped by user: the text, the LLM parse,
/// the page map, and the chunk embeddings are all pure functions of the
/// content, so two readers of the same paper share one row and pay the
/// indexing cost once. Access control lives on `Review` (the user → document
/// edge); a user can only reach a document by presenting its text.
model Document {
  id        String  @id @default(uuid())
  /// sha256 (hex) of the extracted text — the identity key.
  hash      String  @unique
  /// Full extracted text, with `[Page N]` markers at page boundaries. Short
  /// documents are injected into chat whole from here; long ones are served
  /// by retrieval over `chunks`. Null only for rows backfilled from the
  /// legacy per-user caches (which never stored the text); the next open
  /// uploads it.
  text      String?
  charCount Int     @default(0)
  title     String?
  /// Citation-token → page map from the per-page LLM pass (short docs).
  pageMap   Json?
  /// PDF outline (bookmarks) as uploaded, kept so the section tree can be
  /// rebuilt when detection improves without re-uploading the text.
  outline   Json?

  indexStatus    DocumentIndexStatus @default(pending)
  indexError     String?
  /// Set when indexing finishes: which embedding model + width the chunk
  /// vectors were produced with. A model change re-indexes rather than
  /// mixing incompatible vectors in one table.
  embeddingModel String?
  embeddingDims  Int?
  chunkCount     Int                 @default(0)
  /// 0–100 while `indexing`; drives the progress pill in the chat header.
  indexProgress  Int                 @default(0)
  /// Bumped when indexing starts so a stale `indexing` row (crashed worker)
  /// can be retried after a timeout instead of wedging forever.
  indexStartedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  reviews  Review[]
  sections DocumentSection[]
  chunks   DocumentChunk[]
}

enum DocumentIndexStatus {
  pending
  indexing
  ready
  failed
}

/// A node in the document's heading tree (chapter → section → subsection).
/// `label` is the printed number ("3.2", "A.1") when there is one; numbering
/// schemes vary too much to store it as anything but text.
model DocumentSection {
  id         String  @id @default(uuid())
  documentId String
  parentId   String?
  /// Position among siblings (0-based).
  ordinal    Int
  /// 0 = top level, 1 = subsection, ...
  depth      Int
  label      String?
  title      String
  startPage  Int?
  endPage    Int?
  /// Half-open char range [charStart, charEnd) in `Document.text`.
  charStart  Int
  charEnd    Int

  document Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   DocumentSection?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children DocumentSection[] @relation("SectionTree")
  chunks   DocumentChunk[]

  @@index([documentId, ordinal])
}

/// A semantic chunk of a document with its embedding. Chunks never cross a
/// section boundary (chunking runs per section), so `sectionId` is
/// unambiguous when sections were detected. `embedding` is a pgvector
/// `halfvec` — Prisma can't type it, so reads/writes go through raw SQL in
/// `src/server/documents.ts`.
model DocumentChunk {
  id         String                        @id @default(uuid())
  documentId String
  sectionId  String?
  /// Position in the document (0-based, document order).
  ordinal    Int
  text       String
  tokenCount Int
  startPage  Int?
  endPage    Int?
  charStart  Int
  charEnd    Int
  embedding  Unsupported("halfvec(2048)")?

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section  DocumentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([documentId, ordinal])
}

/// A shareable link pointing at one review. The token is the primary key
/// (uuid v4 → 122 bits, URL-safe). `onDelete: Cascade` from Review means
/// deleting the review automatically invalidates all of its shares — no
/// orphans, no manual cleanup.
model Share {
  token        String    @id @default(uuid())
  userId       String
  kind         String // always "review"
  reviewId     String?
  createdAt    DateTime  @default(now())
  /// Soft-delete. Lookups filter on `revokedAt = null`.
  revokedAt    DateTime?
  /// Owner-facing telemetry. Cheap to maintain.
  lastAccessAt DateTime?
  accessCount  Int       @default(0)
  /// Distinct successful imports. "Ever imported" — does not decrement
  /// when the recipient deletes their cloned copy.
  importCount  Int       @default(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reviewId])
}

/// One Discover turn: the user types a query, the agent searches and
/// emits curated picks. The query row groups the recommendations the
/// agent produced and stores the agent's auxiliary notes (Plan/Filter
/// preamble) — short, optional, separate from the chat transcript which
/// is not persisted.
model DiscoverQuery {
  id        String   @id @default(uuid())
  userId    String
  query     String
  /// Auxiliary text the agent emitted alongside the picks (Plan bullets,
  /// Filter line). Optional; trimmed transcript that gives context for
  /// the picks without storing the full chat.
  notes     String?
  /// "running" while the agent stream is in flight, "complete" once the
  /// client finalizes with the parsed picks, "errored" if the stream
  /// failed before producing recommendations.
  status    String   @default("running")
  createdAt DateTime
  /// Project this research belongs to. Every brief is started inside a
  /// project (asking on Home creates one); null only on legacy rows. Reviews
  /// opened from its recommendations are filed into the same project.
  /// Cascade: a brief has nowhere to appear without its project.
  projectId String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId])
}

/// One paper pick from a DiscoverQuery's curated list. The first-class
/// triage entity: the queue UI reads these rows directly. State is
/// encoded as nullable timestamps — `dismissedAt` for dismissed, the
/// existence of a Review with `fromRecommendationId = this.id` for
/// in-library, neither for queued.
model Recommendation {
  id            String    @id @default(uuid())
  queryId       String
  /// 1-indexed position in the agent's submit_picks list — its own
  /// best-to-acceptable ordering. Surfaced in the queue UI so the user
  /// sees what the agent considered the strongest match.
  rank          Int       @default(0)
  url           String
  title         String
  rationale     String
  arxivId       String?
  authors       String?
  publishedDate String?
  publishedYear Int?
  venue         String?
  citationCount Int?
  /// Reading-list judge score, 0 to 1 (TypeSafe Jev, see src/server/judge.ts).
  /// Null until judged, or when judging is unavailable; `rank` is then the
  /// agent's own order. When set, `rank` is the judge's order.
  judgeScore    Float?
  /// Per-dimension scores and confidences behind `judgeScore`, plus the model.
  judgeDetail   Json?
  dismissedAt   DateTime?
  createdAt     DateTime

  query  DiscoverQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  review Review?

  @@index([queryId, rank])
}

/// A named group of reviews. One-to-many: each review belongs to at most
/// one project. Deleting a project sets projectId = null on its reviews
/// (ungroup), rather than cascading deletes.
model Project {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews         Review[]
  discoverQueries DiscoverQuery[]

  @@index([userId])
}
